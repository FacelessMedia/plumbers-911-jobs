# -------------------------------------------------------------
# Plumbers 911 — Environment Variables
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is gitignored and will NEVER be committed.
# -------------------------------------------------------------

# -------------------------------------------------------------
# Go High Level (GHL) — Inbound Webhook (workflow-based, simplest)
# -------------------------------------------------------------
# 1. In GHL, open: Automation -> Workflows -> Create new
# 2. Trigger: "Inbound Webhook"
# 3. GHL will generate a URL like:
#    https://services.leadconnectorhq.com/hooks/<locationId>/webhook-trigger/<webhookId>
# 4. Paste that full URL below. Leave blank to disable GHL forwarding
#    (in that case submissions will still succeed and be logged in Vercel logs).
GHL_WEBHOOK_URL=

# Optional: A shared secret you can configure in GHL to verify the request
# came from your site. If set, we send it as the `x-webhook-secret` header.
GHL_WEBHOOK_SECRET=

# -------------------------------------------------------------
# Go High Level (GHL) — REST API (direct contact creation)
# -------------------------------------------------------------
# Use these if you want to create contacts directly via the GHL REST API
# instead of (or in addition to) the inbound webhook above.
#
# Find Location ID:  Settings -> Business Profile -> "Location ID" (or in URL after /location/)
# Create API Key:    Settings -> Private Integrations -> Create new
#                    Required scopes: contacts.write, contacts.readonly
# (Legacy v1 API keys also work but the v2 Private Integration Token is recommended.)
GHL_LOCATION_ID=
GHL_API_KEY=

# -------------------------------------------------------------
# Notification Email (optional future use)
# -------------------------------------------------------------
# The address GHL should CC / notify on new applications.
APPLY_NOTIFICATION_EMAIL=apply@plumbers911jobs.com
